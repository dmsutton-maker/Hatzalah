# Copy to .env.local, and set the same two values in the Netlify/Vercel dashboard.
# BUILD_BRIEF.md §4.
#
# The anon key is safe to ship publicly ONLY because 04_rls.sql leaves anon with no
# table access and exactly one executable function. If you loosen RLS, this stops
# being true.

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
