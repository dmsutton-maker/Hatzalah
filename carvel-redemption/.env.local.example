# Copy to .env.local, and set the same two values in the Vercel dashboard.
#
# The Apps Script web app URL — the "Web app" URL you get when deploying the script in
# gas/Code.gs. This is the ONLY thing the staff screen talks to.
NEXT_PUBLIC_REDEEM_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# The Google Sheet (the admin). /admin forwards here.
NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/1qGAK_zpTSVUspbi-heRCCSCxqfJJidMW6QAxuIjvKaM/edit
